# Copy to /etc/anchor/anchor.env and set root:root 0600.
ANCHOR_RUNNER_BUNDLE_ROOT=/opt/anchor/releases/REPLACE_WITH_RELEASE_ID/anchor-runtime/bundle
ANCHOR_RUNNER_WEB_ROOT=/opt/anchor/releases/REPLACE_WITH_RELEASE_ID/anchor-runtime/web
ANCHOR_RUNNER_CATALOG_ROOT=/var/lib/anchor/catalog
# Published dependency environments and installed Plugin/tool assets live here.
# When unset the catalog root is used, which mixes immutable content into the
# editable Graph catalog; name it explicitly in a real deployment.
ANCHOR_RUNNER_LIBRARY_ROOT=/var/lib/anchor/library
ANCHOR_RUNNER_STATE_ROOT=/var/lib/anchor/state
ANCHOR_RUNNER_WORKSPACE_ROOT=/var/lib/anchor/workspaces
ANCHOR_RUNNER_GRAPH_NAME=production
ANCHOR_RUNNER_LISTEN=127.0.0.1:8077
ANCHOR_RUNNER_ALLOWED_COMMANDS=sh,git
ANCHOR_BWRAP=/usr/bin/bwrap

# Anchor has one configured Python interpreter, shared by Plugin dependency
# preparation and (when explicitly granted) Pilot authoring. Install and maintain
# a Python 3.8+ prefix; it is mounted read-only for Pilot. This path alone does
# not enable dependency preparation.
# ANCHOR_DEPENDENCIES_PYTHON=/opt/anchor/python-3.12/bin/python3
# Set to 1 only when Pilot may run Python authoring commands.
# ANCHOR_PILOT_PYTHON_ENABLED=1

# Dependency-environment preparation is a separate optional integration:
# uncomment the settings below to enable it, and replace the uv digest.
# ANCHOR_DEPENDENCIES_PYTHON above is also required, but configuring that shared
# interpreter alone does not enable preparation.
#
# Sources are tried in the order written. Each entry is either an absolute
# directory of built distributions or an http(s) index root that already ends in
# `/simple`. An index must be on a public address (an explicit loopback address is
# also accepted) over https — plain http is accepted only for loopback — with no
# credentials, no fragment and a valid port. It must also answer package pages with
# a PEP 691 JSON document (`application/vnd.pypi.simple.v1+json`); that is checked
# against a package page while the plan is frozen, before a human is asked to
# approve it. The mirrors below are the recommended default (TUNA first, then
# USTC). Aliyun, Tencent Cloud and Huawei Cloud serve only HTML package pages and
# are refused; the index *root* does not show this — only the package page's
# content type does.
# ANCHOR_DEPENDENCIES_SOURCES=https://pypi.tuna.tsinghua.edu.cn/simple,https://mirrors.ustc.edu.cn/pypi/simple
# The pinned uv that resolves and fetches; digest from `sha256sum "$(command -v uv)"`.
# ANCHOR_DEPENDENCIES_UV=/opt/anchor/bin/uv
# ANCHOR_DEPENDENCIES_UV_SHA256=REPLACE_WITH_UV_SHA256
# Writable staging root; it must not overlap ANCHOR_RUNNER_LIBRARY_ROOT.
# ANCHOR_DEPENDENCIES_BUILD_ROOT=/var/lib/anchor/environment-build

ANCHOR_GOOSE_BINARY=/opt/anchor/releases/REPLACE_WITH_RELEASE_ID/anchor-runtime/bin/goose
ANCHOR_GOOSE_BINARY_SHA256=dc2a4352279c16f3c665b280e4fc8fedbec3a67cce596bf460aa9fd416c27a15
ANCHOR_GOOSE_ALLOW_SHARED_NETWORK=1

ANCHOR_MODEL_URL=https://provider.example/v1
# Sandbox-dials-the-provider rollback lever; leave 0 so the host proxies model calls.
ANCHOR_MODEL_DIRECT=0
# Sandbox networking: isolation is the default when the relay below (or one
# beside the Goose binary) exists; set 0 to share the host network instead, which
# then requires ANCHOR_GOOSE_ALLOW_SHARED_NETWORK=1.
ANCHOR_GOOSE_LOCAL_NETWORK=1

# AgentNode tool disclosure: unset lets the host disclose on demand once more
# than three mounted tools would be hidden; 1 forces it, 0 keeps every tool listed.
ANCHOR_NODE_TOOL_DISCLOSURE=0
ANCHOR_GOOSE_RELAY_BINARY=/absolute/path/to/anchor-net-relay
ANCHOR_MODEL_API_KEY=REPLACE_WITH_PROVIDER_KEY
ANCHOR_MODEL_NAME=REPLACE_WITH_MODEL_NAME
ANCHOR_MODEL_WIRE_API=responses
ANCHOR_MODEL_ALIASES={}

# Leave it empty for the loopback listener above. Use unique 32+ byte bearer
# secrets when binding beyond loopback; protect and provision this file. An
# explicit `[]` is rejected: set the variable, or leave it blank — not both.
ANCHOR_API_KEYS=

# Optional automatic native WeCom integration. When the selected Graph mounts
# wecom, the Host supplies these values to its supervised Gateway child.
# Optional compatibility override; automatic WeCom supervision derives this
# from ANCHOR_RUNNER_STATE_ROOT and rejects a different path.
# ANCHOR_CHANNEL_CONTROL_DESCRIPTOR=/var/lib/anchor/state/channels/wecom/control.json
# ANCHOR_WECOM_GRAPH=production
# ANCHOR_WECOM_REPLY_NODE=assistant
# WECOM_BOT_ID=REPLACE_WITH_WECOM_BOT_ID
# WECOM_BOT_SECRET=REPLACE_WITH_WECOM_BOT_SECRET
# ANCHOR_WECOM_USERS=REPLACE_WITH_COMMA_SEPARATED_ALLOWED_USER_IDS
# ANCHOR_WECOM_SEND_USERS=REPLACE_WITH_COMMA_SEPARATED_SEND_USER_IDS
# For authenticated gateway callbacks, put the same 32+ byte key in
# ANCHOR_API_KEYS as the gateway's ANCHOR_API_KEY.
