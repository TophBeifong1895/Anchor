+/// Goose persists split call/result pairs. Responses expects all calls from one
+/// original assistant response before its results, with that response's opaque
+/// reasoning replayed once. Only delay outputs whose response has another call;
+/// genuine user input and distinct response ids keep independent groups.
+fn group_response_tool_outputs(items: &mut Vec<Value>, call_responses: &HashMap<usize, String>) {
+    let mut last_calls = HashMap::new();
+    for (index, response) in call_responses {
+        last_calls
+            .entry(response.as_str())
+            .and_modify(|last: &mut usize| *last = (*last).max(*index))
+            .or_insert(*index);
+    }
+    let mut calls = HashMap::new();
+    let mut pending: HashMap<&str, Vec<Value>> = HashMap::new();
+    for (index, item) in std::mem::take(items).into_iter().enumerate() {
+        if let Some(response) = call_responses.get(&index) {
+            if let Some(call) = item.get("call_id").and_then(Value::as_str) {
+                calls.insert(call.to_owned(), response.as_str());
+            }
+        }
+        if item.get("type").and_then(Value::as_str) == Some("function_call_output") {
+            if let Some(response) = item
+                .get("call_id")
+                .and_then(Value::as_str)
+                .and_then(|id| calls.get(id))
+            {
+                if last_calls[response] > index {
+                    pending.entry(response).or_default().push(item);
+                    continue;
+                }
+            }
+        }
+        items.push(item);
+        if let Some(response) = call_responses.get(&index) {
+            if last_calls[response.as_str()] == index {
+                items.extend(pending.remove(response.as_str()).unwrap_or_default());
+            }
+        }
+    }
+    debug_assert!(pending.is_empty());
 }
 
