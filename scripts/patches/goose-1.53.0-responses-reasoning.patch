+    #[tokio::test]
+    async fn streamed_text_remains_after_its_completed_reasoning_item() {
+        let original = reasoning("rs_before_text", "consider the answer");
+        let message = json!({"type":"message", "role":"assistant", "content":[
+            {"type":"output_text", "text":"answer", "annotations":[]}
+        ]});
+        let events = vec![
+            json!({"type":"response.created", "sequence_number":1, "response":response(vec![])}),
+            json!({"type":"response.output_item.done", "sequence_number":2, "output_index":0, "item":original}),
+            json!({"type":"response.output_text.delta", "sequence_number":3, "item_id":"msg_answer",
+                "output_index":1, "content_index":0, "delta":"answer"}),
+            json!({"type":"response.completed", "sequence_number":4, "response":response(vec![original.clone(), message])}),
+        ];
+        let stream = responses_api_to_streaming_message(tokio_stream::iter(
+            events.into_iter().map(|event| Ok(format!("data: {event}"))),
+        ));
+        futures::pin_mut!(stream);
+        let mut conversation = Conversation::default();
+        while let Some(result) = stream.next().await {
+            if let Some(message) = result.unwrap().0 {
+                conversation.push(reload(&message));
+            }
+        }
+        let input = request(conversation.messages());
+        assert_eq!(input["input"][0], original);
+        assert_eq!(input["input"][1]["content"][0]["text"], "answer");
+        assert_eq!(input["input"].as_array().unwrap().len(), 2);
+    }
