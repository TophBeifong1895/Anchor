+                .collect::<Vec<_>>(),
+            vec![
+                "reasoning",
+                "message",
+                "function_call",
+                "function_call",
+                "function_call_output",
+                "function_call_output"
+            ]
+        );
+        assert_eq!(items[0], original);
+        assert_eq!(items[1]["content"][0]["text"], "Inspect both sources");
+        assert_eq!(items[2]["call_id"], call_ids[0]);
+        assert_eq!(items[3]["call_id"], call_ids[1]);
+        assert_eq!(items[4]["call_id"], call_ids[0]);
+        assert_eq!(items[5]["call_id"], call_ids[1]);
+        assert_eq!(items[4]["output"], "observed-0");
+        assert_eq!(items[5]["output"], "observed-1");
+        assert_eq!(serde_json::to_value(&restored).unwrap(), saved);
+    }
+
+    #[test]
+    fn tool_output_grouping_does_not_cross_another_response_or_a_user_message() {
+        for user_boundary in [false, true] {
+            let first: ResponsesApiResponse =
+                serde_json::from_value(response(vec![reasoning("rs_a", "first"), tool("call_a")]))
+                    .unwrap();
+            let mut next = response(vec![reasoning("rs_b", "second"), tool("call_b")]);
+            if !user_boundary {
+                next["id"] = json!("resp_next");
+            }
+            let next: ResponsesApiResponse = serde_json::from_value(next).unwrap();
+            let mut native = Conversation::default();
+            native.push(responses_api_to_message(&first).unwrap());
+            native.push(Message::user().with_tool_response(
+                "call_a",
+                Ok(rmcp::model::CallToolResult::success(vec![
+                    ContentBlock::text("first output"),
+                ])),
+            ));
+            if user_boundary {
+                native.push(Message::user().with_text("a real user message"));
+            }
+            native.push(responses_api_to_message(&next).unwrap());
+            native.push(Message::user().with_tool_response(
+                "call_b",
+                Ok(rmcp::model::CallToolResult::success(vec![
+                    ContentBlock::text("second output"),
+                ])),
+            ));
+            let input = request(native.messages());
+            let items = input["input"].as_array().unwrap();
+            let first_output = items
+                .iter()
+                .position(|item| {
+                    item["type"] == "function_call_output" && item["call_id"] == "call_a"
+                })
+                .unwrap();
+            let next_call = items
+                .iter()
+                .position(|item| item["type"] == "function_call" && item["call_id"] == "call_b")
+                .unwrap();
+            assert!(first_output < next_call);
+        }
+    }
+
+    #[tokio::test]
+    async fn stream_done_and_completed_keep_distinct_reasoning_items_once_and_in_order() {
+        let first = reasoning("rs_first", "same text");
+        let second = reasoning("rs_second", "same text");
+        let final_response = response(vec![first.clone(), second.clone(), tool("call_1")]);
+        let events = vec![
+            json!({"type":"response.created", "sequence_number":1, "response": response(vec![])}),
+            json!({"type":"response.output_item.done", "sequence_number":2, "output_index":0, "item":first}),
+            json!({"type":"response.output_item.done", "sequence_number":3, "output_index":1, "item":second}),
+            json!({"type":"response.output_item.done", "sequence_number":4, "output_index":2, "item":tool("call_1")}),
+            json!({"type":"response.completed", "sequence_number":5, "response":final_response}),
+        ];
+        let lines =
+            tokio_stream::iter(events.into_iter().map(|event| Ok(format!("data: {event}"))));
+        let stream = responses_api_to_streaming_message(lines);
+        futures::pin_mut!(stream);
+        let mut conversation = Conversation::default();
+        while let Some(result) = stream.next().await {
+            if let Some(message) = result.unwrap().0 {
+                conversation.push(reload(&message));
+            }
+        }
+        let input = request(conversation.messages());
+        assert_eq!(input["input"][0], first);
+        assert_eq!(input["input"][1], second);
+        assert_eq!(input["input"][2]["type"], "function_call");
+        assert_eq!(input["input"].as_array().unwrap().len(), 3);
+    }
+
+    #[tokio::test]
+    async fn completion_only_stream_preserves_reasoning_before_tool_call() {
+        let original = reasoning("rs_completion", "call the tool");
+        let completed = json!({"type":"response.completed", "sequence_number":1,
+            "response":response(vec![original.clone(), tool("call_1")])});
+        let stream = responses_api_to_streaming_message(tokio_stream::iter([Ok(format!(
+            "data: {completed}"
+        ))]));
+        futures::pin_mut!(stream);
+        let message = stream.next().await.unwrap().unwrap().0.unwrap();
+        let input = request(&[reload(&message)]);
+        assert_eq!(input["input"][0], original);
+        assert_eq!(input["input"][1]["type"], "function_call");
+        assert!(stream.next().await.is_none());
+    }
