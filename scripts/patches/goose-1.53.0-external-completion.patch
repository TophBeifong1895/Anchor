+//! An opt-in boundary for a host-validated external completion tool.
+//!
+//! The host still owns validation and authorization. Goose owns the tool batch,
+//! native history and the point at which it can stop without another inference.
+
+use crate::conversation::message::{Message, MessageContent};
+use crate::mcp_utils::ToolResult;
+use rmcp::model::CallToolResult;
+use serde_json::{Map, Value};
+
+pub(super) fn tool_name() -> Option<String> {
+    std::env::var("GOOSE_EXTERNAL_COMPLETION_TOOL")
+        .ok()
+        .filter(|name| !name.trim().is_empty())
+}
+
+#[derive(Clone)]
+pub(crate) struct ToolCallBatch {
+    pub id: String,
+    pub size: usize,
+}
+
+impl ToolCallBatch {
+    pub fn new(size: usize) -> Self {
+        Self {
+            id: uuid::Uuid::new_v4().to_string(),
+            size,
+        }
+    }
+}
+
+/// Reserved context comes from the executor, never from model-supplied metadata.
+pub(super) fn inject_batch_meta(meta: &mut Map<String, Value>, batch: Option<&ToolCallBatch>) {
+    meta.retain(|key, _| {
+        !key.eq_ignore_ascii_case("agent-tool-call-batch-id")
+            && !key.eq_ignore_ascii_case("agent-tool-call-batch-size")
+    });
+    if let Some(batch) = batch {
+        meta.insert(
+            "agent-tool-call-batch-id".into(),
+            Value::String(batch.id.clone()),
+        );
+        meta.insert("agent-tool-call-batch-size".into(), Value::from(batch.size));
+    }
+}
+
+pub(super) fn succeeds(
+    expected_tool: Option<&str>,
+    actual_tool: &str,
+    batch: Option<&ToolCallBatch>,
+    result: &ToolResult<CallToolResult>,
+) -> bool {
+    expected_tool == Some(actual_tool)
+        && batch.is_some_and(|batch| batch.size == 1)
+        && result
+            .as_ref()
+            .is_ok_and(|result| result.is_error != Some(true))
+}
+
+/// Keep text/thinking streaming, but collect every executable tool call from one
+/// provider inference before assigning its batch size or dispatching any tool.
+pub(super) fn defer_tools(mut message: Message, pending: &mut Option<Message>) -> Option<Message> {
+    let tools = message
+        .content
+        .iter()
+        .filter(|content| matches!(content, MessageContent::ToolRequest(_)))
+        .cloned()
+        .collect::<Vec<_>>();
+    if tools.is_empty() {
+        return Some(message);
+    }
+    match pending {
+        Some(pending) => pending.content.extend(tools),
+        None => {
+            let mut deferred = message.clone();
+            deferred.content = tools;
+            // The original chunk below emits this marker immediately, even
+            // when it has no text. Do not emit the same limit marker twice.
+            deferred.metadata.output_token_limit_reached = false;
+            *pending = Some(deferred);
+        }
+    }
+    message
+        .content
+        .retain(|content| !matches!(content, MessageContent::ToolRequest(_)));
+    (!message.content.is_empty() || message.metadata.output_token_limit_reached).then_some(message)
+}
+
+#[cfg(test)]
+mod tests {
+    use super::*;
+    use rmcp::model::{CallToolRequestParams, ContentBlock};
+    use serde_json::json;
+
+    #[test]
+    fn deferred_stream_tools_form_one_batch_without_losing_thinking() {
+        let mut pending = None;
+        let first = Message::assistant()
+            .with_thinking("reason", "signature")
+            .with_tool_request("one", Ok(CallToolRequestParams::new("host__finish")));
+        let visible = defer_tools(first, &mut pending).unwrap();
+        assert!(matches!(&visible.content[0], MessageContent::Thinking(_)));
+        assert!(defer_tools(
+            Message::assistant()
+                .with_tool_request("two", Ok(CallToolRequestParams::new("host__work"))),
+            &mut pending
+        )
+        .is_none());
+        assert_eq!(pending.unwrap().content.len(), 2);
+    }
+
+    #[test]
+    fn trusted_batch_overwrites_spoofed_case_variants_and_can_be_removed() {
+        let mut meta = json!({"Agent-Tool-Call-Batch-Id":"forged",
+            "agent-tool-call-batch-size":1,"other":true})
+        .as_object()
+        .unwrap()
+        .clone();
+        let batch = ToolCallBatch::new(2);
+        inject_batch_meta(&mut meta, Some(&batch));
+        assert_eq!(meta["agent-tool-call-batch-id"], batch.id);
+        assert_eq!(meta["agent-tool-call-batch-size"], 2);
+        assert!(!meta.contains_key("Agent-Tool-Call-Batch-Id"));
+        inject_batch_meta(&mut meta, None);
+        assert_eq!(meta, json!({"other":true}).as_object().unwrap().clone());
+    }
+
+    #[test]
+    fn deferred_tool_only_chunks_preserve_first_and_later_output_limit_markers() {
+        for limited_index in 0..2 {
+            let mut pending = None;
+            for index in 0..2 {
+                let mut message = Message::assistant().with_tool_request(
+                    format!("call-{index}"),
+                    Ok(CallToolRequestParams::new("host__work")),
+                );
+                message.metadata.output_token_limit_reached = index == limited_index;
+                let visible = defer_tools(message, &mut pending);
+                if index == limited_index {
+                    let marker = visible.expect("tool-only limit marker must remain visible");
+                    assert!(marker.content.is_empty());
+                    assert!(marker.metadata.output_token_limit_reached);
+                } else {
+                    assert!(visible.is_none());
+                }
+            }
+            let deferred = pending.unwrap();
+            assert_eq!(deferred.content.len(), 2);
+            assert!(!deferred.metadata.output_token_limit_reached);
+        }
+    }
+
+    #[test]
+    fn only_the_sole_successful_configured_tool_finishes() {
+        let success = Ok(CallToolResult::success(vec![ContentBlock::text(
+            "accepted",
+        )]));
+        let failure = Ok(CallToolResult::error(vec![ContentBlock::text("rejected")]));
+        let single = ToolCallBatch::new(1);
+        let mixed = ToolCallBatch::new(2);
+        assert!(succeeds(
+            Some("host__finish"),
+            "host__finish",
+            Some(&single),
+            &success
+        ));
+        assert!(!succeeds(
+            Some("host__finish"),
+            "host__finish",
+            Some(&mixed),
+            &success
+        ));
+        assert!(!succeeds(
+            Some("host__finish"),
+            "host__finish",
+            Some(&single),
+            &failure
+        ));
+        assert!(!succeeds(None, "host__finish", Some(&single), &success));
+        assert!(!succeeds(
+            Some("host__finish"),
+            "host__work",
+            Some(&single),
+            &success
+        ));
+    }
+}
